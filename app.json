{
  "expo": {
    "name": "HealthConnect",
    "slug": "healthcare-platform",
    "description": "HealthConnect — book and manage healthcare appointments",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/AppLogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/AppLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90E2",
      "dark": {
        "backgroundColor": "#0F172A"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "healthconnect",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthconnect.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to find nearby doctors.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to find nearby doctors.",
        "ITSAppUsesNonExemptEncryption": false,
        "GADApplicationIdentifier": "ca-app-pub-1741941427300096~1571982751"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppLogo.png",
        "backgroundColor": "#4A90E2"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.healthconnect.app",
      "versionCode": 6,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/AppLogo.png"
    },
    "plugins": [
      [
        "./src/plugins/expo-admob-plugin",
        {
          "appId": "ca-app-pub-1741941427300096~1571982751"
        }
      ],

      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "kotlinVersion": "1.8.21"
        }
      ],
      [
        "expo-notifications"
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow HealthConnect to use your location to find nearby doctors."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "owner": "solaabara1",
    "extra": {
      "eas": {
        "projectId": "ed9f8d9d-3dd9-4175-9f26-cd01207e91e1"
      }
    }
  },
  
}
