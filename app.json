{
  "expo": {
    "name": "HealthConnect",
    "slug": "healthcare-platform",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/6.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/6.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90E2"
    },
    "assetBundlePatterns": ["**/*"],
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthconnect.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to find nearby doctors.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to find nearby doctors.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/6.png",
        "backgroundColor": "#4A90E2"
      },
      "package": "com.healthconnect.app",
      "versionCode": 6,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": { "favicon": "./assets/6.png" },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow HealthConnect to use your location to find nearby doctors."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e64294f8-1204-4c06-9e4b-5507b7980f39"
      }
    },
    "owner": "soulaimane22"
  }
}

